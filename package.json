{
  "name": "obsidian-projects",
  "version": "1.17.4",
  "description": "Plain text project planning for Obsidian",
  "packageManager": "pnpm@10.28.2",
  "main": "build/main.js",
  "scripts": {
    "dev": "node config/build/esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node config/build/esbuild.config.mjs production && npm run sass-build && npm run sync-build-manifest",
    "sync-build-manifest": "node scripts/release/sync-build-manifest.mjs",
    "version": "node scripts/release/version-bump.mjs && git add manifest.json versions.json",
    "test": "jest --config config/test/jest.config.cjs",
    "svelte-check": "svelte-check",
    "lint": "eslint --config config/lint/eslint.config.mjs ./src",
    "format": "prettier -w ./src",
    "sass-build": "sass ./css/styles.scss ./build/styles.css",
    "sass-watch": "sass --watch ./css/styles.scss ./build/styles.css"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.15.0",
    "@interactjs/interact": "^1.10.27",
    "@interactjs/types": "^1.10.27",
    "@popperjs/core": "^2.11.8",
    "@tsconfig/svelte": "^5.0.8",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.1",
    "@types/sortablejs": "^1.15.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "builtin-modules": "^3.3.0",
    "dayjs": "^1.11.11",
    "esbuild": "^0.27.4",
    "esbuild-jest": "^0.5.0",
    "esbuild-plugin-replace": "^1.4.0",
    "esbuild-svelte": "^0.9.4",
    "eslint": "^9.15.0",
    "eslint-plugin-tsdoc": "^0.4.0",
    "fp-ts": "^2.16.6",
    "globals": "^15.12.0",
    "i18next": "^24.0.2",
    "immer": "^10.1.1",
    "jest": "^29.7.0",
    "obsidian": "^1.12.3",
    "obsidian-dataview": "^0.5.67",
    "obsidian-svelte": "0.2.1",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.3.0",
    "sass": "^1.77.2",
    "svelte": "^5.54.0",
    "svelte-check": "^4.4.5",
    "svelte-dnd-action": "0.9.52",
    "svelte-i18next": "^2.2.2",
    "svelte-media-queries": "^1.6.2",
    "svelte-preprocess": "^6.0.3",
    "ts-essentials": "^10.0.3",
    "ts-jest": "^29.1.3",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
    "uuid": "^11.0.3",
    "yaml": "^2.4.2"
  }
}